# Opcional. Sin este archivo, la sala usa la voz del navegador.
# Copialo como .env y completá tu clave para usar ElevenLabs.

# https://elevenlabs.io/app/settings/api-keys  (permiso necesario: Text to Speech)
ELEVENLABS_API_KEY=
# Voz a usar. Por defecto: Liam (TX3LPaxmHKxFdv7VOQHJ), una voz predeterminada que funciona en el plan gratis.
ELEVENLABS_VOICE_ID=TX3LPaxmHKxFdv7VOQHJ
# Modelo multilingüe (habla español)
ELEVENLABS_MODEL=eleven_multilingual_v2
# Cómo se llama el dueño: el asesor lo llama por su nombre (opcional)
NOMBRE_DUENO=
# Puerto de la sala
PORT=4740
